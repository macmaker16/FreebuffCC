{
  "name": "michaelangelo",
  "version": "1.0.0",
  "description": "Michaelangelo - Free AI Coding Agent with OpenRouter/NIM Proxy",
  "main": "dist/main/main.js",
  "author": "macmaker16",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently \"npm run dev:main\" \"npm run dev:renderer\"",
    "dev:main": "tsc -p tsconfig.main.json --watch",
    "dev:renderer": "vite",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "start": "electron .",
    "package": "npm run build && electron-builder --win --config",
    "package:portable": "npm run build && electron-builder --win portable --config",
    "package:nsis": "npm run build && electron-builder --win nsis --config",
    "agent:headless": "node dist/main/headless.js"
  },
  "dependencies": {
    "electron-store": "^8.1.0",
    "electron-updater": "^6.8.9",
    "express": "^4.18.2",
    "lucide-react": "^0.294.0",
    "playwright-core": "^1.62.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.3.5",
    "typescript": "^5.2.2",
    "vite": "^5.0.0"
  },
  "build": {
    "appId": "com.macmaker16.michaelangelo",
    "productName": "Michaelangelo",
    "copyright": "Copyright © 2026 macmaker16",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "assets/**/*",
      "!node_modules/playwright-core/**",
      "!node_modules/playwright/**"
    ],
    "extraResources": [],
    "publish": {
      "provider": "github",
      "owner": "macmaker16",
      "repo": "Michaelangelo",
      "releaseType": "release"
    },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "Michaelangelo-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Michaelangelo",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "deleteAppDataOnUninstall": false,
      "allowElevation": true,
      "installerLanguages": ["en_US"]
    },
    "portable": {
      "artifactName": "Michaelangelo-${version}-portable.${ext}"
    }
  }
}
